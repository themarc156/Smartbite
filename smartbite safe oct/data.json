{
  "dishes": [
    {
      "id": "dish-spaghetti",
      "name": "Spaghetti Bolognese",
      "isEmergency": false,
      "isMeat": true,
      "isHighCarb": true,
      "ingredients": "500g Spaghetti\n500g Rinderhackfleisch\n1 Zwiebel\n2 Knoblauchzehen\n2 Dosen gehackte Tomaten\nSalz, Pfeffer, Oregano",
      "instructions": "1. Spaghetti in Salzwasser kochen.\n2. Hackfleisch mit Zwiebeln und Knoblauch anbraten.\n3. Tomaten dazugeben und 15 Minuten köcheln lassen.\n4. Mit Gewürzen abschmecken und servieren.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142730/smartbite_recipes/hjfonjmnnehqdwpmkaor.jpg"
    },
    {
      "id": "dish-toast",
      "name": "Toast Hawaii",
      "isEmergency": true,
      "isMeat": null,
      "isHighCarb": true,
      "ingredients": "Toastbrot\nButter\nSchinken\nAnanasscheiben\nGouda (gerieben)",
      "instructions": "1. Toastbrot toasten und mit Butter bestreichen.\n2. Schinken und Ananas auf das Toast legen.\n3. Mit Käse bedecken und im Ofen bei 200°C überbacken, bis der Käse schmilzt.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142730/smartbite_recipes/htegg0uxoueswnxdfijo.webp"
    },
    {
      "id": "dish-chili",
      "name": "Chili con Carne",
      "isEmergency": false,
      "isMeat": true,
      "isHighCarb": false,
      "ingredients": "500g Hackfleisch\n1 Dose Kidneybohnen\n1 Dose Mais\n1 Dose gestückelte Tomaten\nPaprikapulver, Kreuzkümmel, Chili",
      "instructions": "1. Hackfleisch scharf anbraten.\n2. Tomaten, Bohnen und Mais hinzufügen.\n3. Mit Gewürzen abschmecken und bei mittlerer Hitze 20 Minuten köcheln lassen.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142731/smartbite_recipes/efhtzwk8mj34wkvwc7ms.webp"
    },
    {
      "id": "dish-pizza",
      "name": "Pizza",
      "isEmergency": false,
      "isMeat": null,
      "isHighCarb": true,
      "ingredients": "Pizzateig (aus dem Kühlregal)\nTomatensoße\nSalami / Schinken\nGeriebener Käse",
      "instructions": "2. Pizzateig ausrollen und mit Tomatensoße bestreichen.\n2. Nach Wunsch belegen und mit Käse bestreuen.\n3. Im Ofen bei 220°C Ober-/Unterhitze ca. 12-15 Minuten backen.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142732/smartbite_recipes/hmh2ovgb6s1ucnprzk0v.jpg"
    },
    {
      "id": "dish-pfannkuchen",
      "name": "Pfannkuchen",
      "isEmergency": true,
      "isMeat": false,
      "isHighCarb": true,
      "ingredients": "300g Mehl\n500ml Milch\n3 Eier\n1 Prise Salz\nButter zum Ausbacken",
      "instructions": "1. Alle Zutaten zu einem glatten Teig verrühren.\n2. Portionsweise in einer heißen Pfanne mit Butter goldgelb ausbacken.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142733/smartbite_recipes/fsysl6zdq2gocjqfpxtg.jpg"
    },
    {
      "id": "dish-wraps",
      "name": "Wraps",
      "isEmergency": true,
      "isMeat": null,
      "isHighCarb": false,
      "ingredients": "Tortilla-Wraps\nHähnchenbruststreifen\nSalat, Tomaten, Gurke\nFrischkäse oder Soße",
      "instructions": "1. Hähnchen anbraten und würzen.\n2. Wraps kurz in der Pfanne oder Mikrowelle erwärmen.\n3. Mit Frischkäse bestreichen, Gemüse und Fleisch einrollen.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142734/smartbite_recipes/g6qelb8jpp10uhtpdc9x.jpg"
    },
    {
      "id": "dish-burger",
      "name": "Burger",
      "isEmergency": false,
      "isMeat": true,
      "isHighCarb": true,
      "ingredients": "Burger-Buns\nBurger-P patties (Rindfleisch)\nSalat, Tomate, Gewürzgurke\nBurger-Soße",
      "instructions": "1. Patties von beiden Seiten braten.\n2. Buns kurz aufchnittgeröstet anrösten.\n3. Nach Belieben belegen und zusammenbauen.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142735/smartbite_recipes/jdazsfzro5gtgarujnmx.jpg"
    },
    {
      "id": "dish-maultaschen",
      "name": "Maultaschen",
      "isEmergency": true,
      "isMeat": false,
      "isHighCarb": false,
      "ingredients": "1 Packung Maultaschen\nBrühe oder Butter & Zwiebeln",
      "instructions": "1. Maultaschen in Streifen schneiden und in einer Pfanne mit Zwiebeln anbraten (oder in heißer Brühe ziehen lassen).",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142736/smartbite_recipes/f7rfzyfvvcsj1lhrtowr.webp"
    },
    {
      "id": "dish-matjes",
      "name": "Matjesbrötchen",
      "isEmergency": true,
      "isMeat": null,
      "isHighCarb": true,
      "ingredients": "Frische Brötchen\nMatjesfilets\nZwiebelringe\nButter oder Remoulade",
      "instructions": "1. Brötchen aufschneiden und bestreichen.\n2. Matjes und Zwiebeln hineinlegen.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142736/smartbite_recipes/qrrywp7ws4p31guvhxzj.jpg"
    },
    {
      "id": "dish-gruenkohl",
      "name": "Grünkohl",
      "isEmergency": false,
      "isMeat": null,
      "isHighCarb": false,
      "ingredients": "Grünkohl (Glas/Frost)\nKohlatavwurst / Pinkel\nKartoffeln",
      "instructions": "1. Grünkohl mit Wurst im Topf langsam schmoren lassen.\n2. Dazu Salzkartoffeln servieren.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142738/smartbite_recipes/h1u5mrnfiwud7nfwqjso.webp"
    },
    {
      "id": "dish-ofenkartoffeln",
      "name": "Ofenkartoffeln",
      "isEmergency": false,
      "isMeat": false,
      "isHighCarb": true,
      "ingredients": "Große Festkochende Kartoffeln\nOlivenöl, Salz\nQuark / Kräuterbutter",
      "instructions": "1. Kartoffeln mit Olivenöl und Salz einreiben und bei 200°C ca. 45-50 Min. im Ofen backen.\n2. Mit Kräuterquark servieren.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142738/smartbite_recipes/pqnxkaigz74xiexnyo7b.jpg"
    },
    {
      "id": "dish-paprika",
      "name": "Gefüllte Paprika",
      "isEmergency": false,
      "isMeat": null,
      "isHighCarb": false,
      "ingredients": "Paprikaschoten\nHackfleisch\nReis\nTomatensoße",
      "instructions": "1. Hackfleisch mit gekochtem Reis mischen und in die ausgehöhlten Paprika füllen.\n2. In eine Auflaufform stellen, Tomatensoße darum gießen und im Ofen bei 180°C ca. 40 Min. garen.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142739/smartbite_recipes/kkb7ekw1hpw4btxpxcza.webp"
    },
    {
      "id": "dish-ofengemuese",
      "name": "Ofengemüse",
      "isEmergency": false,
      "isMeat": false,
      "isHighCarb": false,
      "ingredients": "Karotten, Zucchini, Paprika, Kartoffeln\nOlivenöl, Kräuter der Provence, Feta",
      "instructions": "1. Gemüse klein schneiden, mit Öl und Gewürzen vermengen.\n2. Auf einem Blech bei 200°C ca. 30 Min. backen. Evtl. Feta drüberstreuen.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142740/smartbite_recipes/fcylddtpjwujkwnbptla.jpg"
    },
    {
      "id": "dish-griessbrei",
      "name": "Grießbrei",
      "isEmergency": true,
      "isMeat": false,
      "isHighCarb": true,
      "ingredients": "500ml Milch\n5 EL Weichweizengrieß\n2 EL Zucker\nZimt & Zucker",
      "instructions": "1. Milch aufkochen, Grieß und Zucker einrühren.\n2. Unter Rühren kurz aufquellen lassen, mit Zimt & Zucker servieren.",
      "image": "https://res.cloudinary.com/da6e8pwi/image/upload/v1790142741/smartbite_recipes/tcm09qssjqfst9smzsvd.webp"
    }
